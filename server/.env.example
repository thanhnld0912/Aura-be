# AURA backend — copy to .env and fill in.
# .env is gitignored. No value in this file is ever a real secret.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura
DATABASE_POOL_MAX=10

# ── Supabase (auth + storage) ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=meal-photos

# ── AI ────────────────────────────────────────────────────────────────────
# Server only. These must NEVER appear in aura-companion or any client bundle.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

AI_MODEL_REASONING=claude-opus-5
AI_MODEL_EXTRACTION=claude-haiku-4-5
AI_MODEL_VISION=gemini-2.5-flash

# ── Nutrition providers ───────────────────────────────────────────────────
USDA_API_KEY=
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1

OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
# Required — Open Food Facts blocks anonymous clients.
OPEN_FOOD_FACTS_USER_AGENT=AURA/1.0 (contact@example.com)

# ── Security ──────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_BYTES=8388608

# ── Scheduled jobs ────────────────────────────────────────────────────────
CRON_ENABLED=true
CRON_TIMEZONE=Asia/Ho_Chi_Minh
