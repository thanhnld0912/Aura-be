# AURA backend — copy to .env and fill in.
# .env is gitignored. No value in this file is ever a real secret.
#
# Parsed once at boot by src/config/env.ts. A malformed value crashes the process
# with a readable message rather than failing opaquely later (DEPLOYMENT.md §3).
#
# [required]  needed to boot today
# [phase N]   optional until that phase; where to obtain it is noted inline

# [required] development | test | production
NODE_ENV=development
PORT=3001
# Bind address. 0.0.0.0 inside a container; 127.0.0.1 is fine locally.
HOST=0.0.0.0
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────
# [required] Supabase → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura
DATABASE_POOL_MAX=10

# ── Supabase (auth + storage) ─────────────────────────────────────────────
# [phase 2] Supabase → Project Settings → API
SUPABASE_URL=
# [phase 2] service role — bypasses RLS, server only, never in a client bundle
SUPABASE_SERVICE_ROLE_KEY=
# [phase 2] used to verify the JWT the frontend sends
SUPABASE_JWT_SECRET=
# [phase 4] private bucket for meal photos
SUPABASE_STORAGE_BUCKET=meal-photos

# ── AI ────────────────────────────────────────────────────────────────────
# Server only. These must NEVER appear in aura-companion or any client bundle.
# [phase 4] console.anthropic.com
ANTHROPIC_API_KEY=
# [phase 4] aistudio.google.com
GEMINI_API_KEY=

AI_MODEL_REASONING=claude-opus-5
AI_MODEL_EXTRACTION=claude-haiku-4-5
AI_MODEL_VISION=gemini-2.5-flash

# ── Nutrition providers ───────────────────────────────────────────────────
# [phase 3] fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1

OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
# Required — Open Food Facts blocks anonymous clients.
OPEN_FOOD_FACTS_USER_AGENT=AURA/1.0 (contact@example.com)

# ── Security ──────────────────────────────────────────────────────────────
# [required] explicit allowlist, comma-separated. Never `*`.
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_ENABLED=true
# [optional] Serves Swagger UI at /docs and the OpenAPI document at /docs/json.
# On by default. Consider false in a public production deployment — the document is a
# complete map of the API surface.
DOCS_ENABLED=true
MAX_UPLOAD_BYTES=8388608

# ── Scheduled jobs ────────────────────────────────────────────────────────
# [phase 5]
CRON_ENABLED=true
CRON_TIMEZONE=Asia/Ho_Chi_Minh

# ── Tests ─────────────────────────────────────────────────────────────────
# [optional] Set to opt the database-backed integration tests in. Unset, they skip,
# so the suite runs without Docker. CI sets it to the throwaway service container.
TEST_DATABASE_URL=
